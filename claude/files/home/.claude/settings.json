{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "rtk hook claude"}]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "statusLine": {
    "type": "command",
    "command": "/home/agent/.claude/statusline/statusline.sh"
  }
}
